        "contacts.read"
      ],
      "state": "planned",
      "optionalCredentialEnv": [
        "GOOGLE_REDIRECT_URI",
        "GOOGLE_GRANTED_SCOPES"
      ]
    },
    {
      "id": "digitalocean",
      "provider": "DigitalOcean",
      "priority": 1,
      "routes": [
        "official-api",
        "doctl-cli",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "DIGITALOCEAN_ACCESS_TOKEN"
      ],
      "targetCapabilities": [
        "account.read",
        "droplets.read",
        "droplets.write",
        "network.read"
      ],
      "state": "planned"
    },
    {
      "id": "microsoft-graph",
      "provider": "Microsoft",
      "priority": 2,
      "routes": [
        "microsoft-oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "MICROSOFT_CLIENT_ID",
        "MICROSOFT_TENANT_ID",
        "MICROSOFT_REFRESH_TOKEN",
        "MICROSOFT_SCOPES"
      ],
      "targetCapabilities": [
        "mail.read",
        "mail.send",
        "mail.modify",
        "calendar.read",
        "calendar.write"
      ],
      "state": "planned",
      "optionalCredentialEnv": [
        "MICROSOFT_CLIENT_SECRET"
      ],
      "requiredReadScopes": [
        "openid",
        "offline_access",
        "User.Read",
        "Mail.Read",
        "Calendars.Read"
      ],
      "requiredWriteScopes": [
        "Mail.Send",
        "Calendars.ReadWrite"
      ]
    },
    {
      "id": "dropbox",
      "provider": "Dropbox",
      "priority": 2,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [],
      "targetCapabilities": [
        "files.search",
        "files.read",
        "files.write"
      ],
      "state": "planned",
      "credentialAlternatives": [
        [
          "DROPBOX_ACCESS_TOKEN"
        ],
        [
          "DROPBOX_APP_KEY",
          "DROPBOX_APP_SECRET",
          "DROPBOX_REFRESH_TOKEN"
        ]
      ]
    },
    {
      "id": "notion",
      "provider": "Notion",
      "priority": 2,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [],
      "targetCapabilities": [
        "search",
        "pages.read",
        "pages.write",
        "databases.read",
        "databases.write"
      ],
      "state": "planned",
      "credentialAlternatives": [
        [
          "NOTION_TOKEN"
        ],
        [
          "NOTION_ACCESS_TOKEN"
        ]
      ],
      "optionalCredentialEnv": [
        "NOTION_VERSION"
      ],
      "defaultApiVersion": "2026-03-11"
    },
    {
      "id": "linear",
      "provider": "Linear",
      "priority": 2,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [],
      "targetCapabilities": [
        "issues.read",
        "issues.write",
        "projects.read",
        "projects.write"
      ],
      "state": "planned",
      "credentialAlternatives": [
        [
          "LINEAR_API_KEY"
        ],
        [
          "LINEAR_ACCESS_TOKEN"
        ]
      ],
      "notes": [
        "Personal API key is the preferred always-on single-user route; OAuth access tokens are also supported."
      ]
    },
    {
      "id": "zoom",
      "provider": "Zoom",
      "priority": 3,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [],
      "targetCapabilities": [
        "meetings.read",
        "recordings.read"
      ],
      "state": "planned",
      "credentialAlternatives": [
        [
          "ZOOM_ACCESS_TOKEN"
        ],
        [
          "ZOOM_CLIENT_ID",
          "ZOOM_CLIENT_SECRET",
          "ZOOM_REFRESH_TOKEN"
        ],
        [
          "ZOOM_ACCOUNT_ID",
          "ZOOM_CLIENT_ID",
          "ZOOM_CLIENT_SECRET"
        ]
      ],
      "optionalCredentialEnv": [
        "ZOOM_USER_ID"
      ],
      "notes": [
        "ZOOM_USER_ID or an explicit userId is required for server-to-server user/meeting routes.",
        "The live probe verifies meeting access, not merely token issuance."
      ]
    },
    {
      "id": "spotify",
      "provider": "Spotify",
      "priority": 3,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "SPOTIFY_CLIENT_ID",
        "SPOTIFY_CLIENT_SECRET",
        "SPOTIFY_REFRESH_TOKEN"
      ],
      "targetCapabilities": [
        "profile.read",
        "library.read",
        "playlists.read",
        "playlists.write"
      ],
      "state": "planned",
      "optionalCredentialEnv": [
        "SPOTIFY_REDIRECT_URI",
        "SPOTIFY_SCOPES",
        "SPOTIFY_GRANTED_SCOPES"
      ],
      "requiredReadScopes": [
        "user-read-private",
        "playlist-read-private"
      ],
      "requiredWriteScopes": [
        "playlist-modify-private",
        "playlist-modify-public"
      ],
      "notes": [
        "Use the browser OAuth callback for persistent user access.",
        "Spotify refresh tokens currently expire after six months; reauthorization must be expected rather than treated as a permanent credential."
      ]
    },
    {
      "id": "apple-music",
      "provider": "Apple Music",
      "priority": 3,
      "routes": [
        "musickit",
        "host-local-bridge"
      ],
      "credentialEnv": [
        "APPLE_MUSIC_DEVELOPER_TOKEN"
      ],
      "targetCapabilities": [
        "catalog.search",
        "library.read",
        "playlists.write"
      ],
      "state": "planned"
    },
    {
      "id": "figma",
      "provider": "Figma",
      "priority": 3,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [],
      "targetCapabilities": [
        "files.read",
        "comments.read",
        "comments.write"
      ],
      "state": "planned",
      "credentialAlternatives": [
        [
          "FIGMA_TOKEN"
        ],
        [
          "FIGMA_ACCESS_TOKEN"
        ]
      ],
      "requiredReadScopes": [
        "file_content:read",
        "file_metadata:read"
      ],
      "optionalReadScopes": [
        "file_comments:read"
      ],
      "notes": [
        "Personal access tokens use X-Figma-Token; OAuth access tokens use Bearer authentication."
      ]
    },
    {
      "id": "canva",
      "provider": "Canva",
      "priority": 3,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [],
      "targetCapabilities": [
        "designs.read",
        "designs.write"
      ],
      "state": "planned",
      "credentialAlternatives": [
        [
          "CANVA_ACCESS_TOKEN"
        ],
        [
          "CANVA_CLIENT_ID",
          "CANVA_CLIENT_SECRET",
          "CANVA_REFRESH_TOKEN"
        ]
      ],
      "requiredReadScopes": [
        "design:meta:read"
      ],
      "optionalReadScopes": [
        "profile:read"
      ],
      "secretState": [
        "~/.openclaw/kit/secrets/canva.json"
      ],
      "notes": [
        "Refresh-token rotation is persisted in private host state and never committed to Git.",
        "The identity probe uses /rest/v1/users/me, which requires no specific scope."
      ]
    },
    {
      "id": "adobe-photoshop",
      "provider": "Adobe Photoshop / Firefly Services",
      "priority": 3,
      "routes": [
        "adobe-ims-oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [],
      "credentialAlternatives": [
        [
          "ADOBE_PHOTOSHOP_ACCESS_TOKEN",
          "ADOBE_PHOTOSHOP_CLIENT_ID"
        ],
        [
          "ADOBE_PHOTOSHOP_CLIENT_ID",
          "ADOBE_PHOTOSHOP_CLIENT_SECRET"
        ]
      ],
      "optionalCredentialEnv": [
        "ADOBE_PHOTOSHOP_SCOPES"
      ],
      "targetCapabilities": [
        "creative.read",
        "creative.write",
        "image.jobs"
      ],
      "state": "planned",
      "notes": [
        "Live verification uses Adobe's documented Photoshop API hello endpoint.",
        "Photoshop API v2 is the current production target; v1 is end-of-life."
      ]
    },
    {
      "id": "adobe-pdf-services",
      "provider": "Adobe Acrobat PDF Services",
      "priority": 3,
      "routes": [
        "client-credentials",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "ADOBE_PDF_CLIENT_ID",
        "ADOBE_PDF_CLIENT_SECRET"
      ],
      "targetCapabilities": [
        "documents.read",
        "documents.write",
        "pdf.create",
        "pdf.export",
        "pdf.compress",
        "pdf.ocr",
        "pdf.extract"
      ],
      "state": "planned",
      "verificationPolicy": "Token issuance proves authentication only. Do not mark read-verified or write-verified until a real PDF Services operation succeeds and its output is retrieved."
    },
    {
      "id": "openai-api",
      "provider": "OpenAI",
      "priority": 1,
      "routes": [
        "official-api",
        "openclaw-model-provider",
        "browser-console-last-resort"
      ],
      "credentialEnv": [
        "OPENAI_API_KEY"
      ],
      "optionalCredentialEnv": [
        "OPENAI_PROJECT_ID",
        "OPENAI_ORG_ID"
      ],
      "targetCapabilities": [
        "models.list",
        "models.read",
        "responses.create",
        "files.read",
        "files.write"
      ],
      "state": "planned",
      "requiredReadScopes": [
        "project-api-key"
      ],
      "requiredWriteScopes": [
        "project-api-key"
      ],
      "notes": [
        "Prefer a dedicated project service-account API key for the persistent Kit runtime.",
        "A normal project API key is not an OpenAI Admin API key; organization/project administration should use a separate admin credential and adapter."
      ]
    },
