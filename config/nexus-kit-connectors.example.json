    {
      "id": "zoom",
      "provider": "Zoom",
      "priority": 3,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [],
      "targetCapabilities": [
        "meetings.read",
        "recordings.read"
      ],
      "state": "planned",
      "credentialAlternatives": [
        [
          "ZOOM_ACCESS_TOKEN"
        ],
        [
          "ZOOM_CLIENT_ID",
          "ZOOM_CLIENT_SECRET",
          "ZOOM_REFRESH_TOKEN"
        ],
        [
          "ZOOM_ACCOUNT_ID",
