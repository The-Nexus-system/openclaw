{
  "schemaVersion": 1,
  "policy": {
    "preferIndependentProviderAccess": true,
    "browserAutomationLastResort": true,
    "requirePostconditionVerification": true,
    "storeSecretsInGit": false
  },
  "connectors": [
    {
      "id": "github",
      "provider": "GitHub",
      "priority": 1,
      "routes": [
        "official-api",
        "gh-cli",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "GITHUB_TOKEN"
      ],
      "targetCapabilities": [
        "repos.read",
        "repos.write",
        "issues.read",
        "issues.write",
        "pulls.read",
        "pulls.write"
      ],
      "state": "planned"
    },
    {
      "id": "gmail",
      "provider": "Google",
      "priority": 1,
      "routes": [
        "google-oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REFRESH_TOKEN"
      ],
      "targetCapabilities": [
        "mail.search",
        "mail.read",
        "mail.send",
        "mail.modify"
      ],
      "state": "planned"
    },
    {
      "id": "google-calendar",
      "provider": "Google",
      "priority": 1,
      "routes": [
        "google-oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REFRESH_TOKEN"
      ],
      "targetCapabilities": [
        "calendar.read",
        "calendar.write"
      ],
      "state": "planned"
    },
    {
      "id": "google-drive",
      "provider": "Google",
      "priority": 1,
      "routes": [
        "google-oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REFRESH_TOKEN"
      ],
      "targetCapabilities": [
        "drive.search",
        "drive.read",
        "drive.write"
      ],
      "state": "planned"
    },
    {
      "id": "google-contacts",
      "provider": "Google",
      "priority": 2,
      "routes": [
        "google-oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REFRESH_TOKEN"
      ],
      "targetCapabilities": [
        "contacts.search",
        "contacts.read"
      ],
      "state": "planned"
    },
    {
      "id": "digitalocean",
      "provider": "DigitalOcean",
      "priority": 1,
      "routes": [
        "official-api",
        "doctl-cli",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "DIGITALOCEAN_ACCESS_TOKEN"
      ],
      "targetCapabilities": [
        "account.read",
        "droplets.read",
        "droplets.write",
        "network.read"
      ],
      "state": "planned"
    },
    {
      "id": "microsoft-graph",
      "provider": "Microsoft",
      "priority": 2,
      "routes": [
        "microsoft-oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "MICROSOFT_CLIENT_ID",
        "MICROSOFT_TENANT_ID",
        "MICROSOFT_REFRESH_TOKEN",
        "MICROSOFT_SCOPES"
      ],
      "targetCapabilities": [
        "mail.read",
        "mail.send",
        "mail.modify",
        "calendar.read",
        "calendar.write"
      ],
      "state": "planned",
      "optionalCredentialEnv": [
        "MICROSOFT_CLIENT_SECRET"
      ],
      "requiredReadScopes": [
        "openid",
        "offline_access",
        "User.Read",
        "Mail.Read",
        "Calendars.Read"
      ],
      "requiredWriteScopes": [
        "Mail.Send",
        "Calendars.ReadWrite"
      ]
    },
    {
      "id": "dropbox",
      "provider": "Dropbox",
      "priority": 2,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [],
      "targetCapabilities": [
        "files.search",
        "files.read",
        "files.write"
      ],
      "state": "planned",
      "credentialAlternatives": [
        [
          "DROPBOX_ACCESS_TOKEN"
        ],
        [
          "DROPBOX_APP_KEY",
          "DROPBOX_APP_SECRET",
          "DROPBOX_REFRESH_TOKEN"
        ]
      ]
    },
    {
      "id": "notion",
      "provider": "Notion",
      "priority": 2,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [],
      "targetCapabilities": [
        "search",
        "pages.read",
        "pages.write",
        "databases.read",
        "databases.write"
      ],
      "state": "planned",
      "credentialAlternatives": [
        [
          "NOTION_TOKEN"
        ],
        [
          "NOTION_ACCESS_TOKEN"
        ]
      ],
      "optionalCredentialEnv": [
        "NOTION_VERSION"
      ],
      "defaultApiVersion": "2026-03-11"
    },
    {
      "id": "linear",
      "provider": "Linear",
      "priority": 2,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [],
      "targetCapabilities": [
        "issues.read",
        "issues.write",
        "projects.read",
        "projects.write"
      ],
      "state": "planned",
      "credentialAlternatives": [
        [
          "LINEAR_API_KEY"
        ],
        [
          "LINEAR_ACCESS_TOKEN"
        ]
      ],
      "notes": [
        "Personal API key is the preferred always-on single-user route; OAuth access tokens are also supported."
      ]
    },
    {
      "id": "zoom",
      "provider": "Zoom",
      "priority": 3,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [],
      "targetCapabilities": [
        "meetings.read",
        "recordings.read"
      ],
      "state": "planned",
      "credentialAlternatives": [
        [
          "ZOOM_ACCESS_TOKEN"
        ],
        [
          "ZOOM_CLIENT_ID",
          "ZOOM_CLIENT_SECRET",
          "ZOOM_REFRESH_TOKEN"
        ],
        [
          "ZOOM_ACCOUNT_ID",
          "ZOOM_CLIENT_ID",
          "ZOOM_CLIENT_SECRET"
        ]
      ],
      "optionalCredentialEnv": [
        "ZOOM_USER_ID"
      ],
      "notes": [
        "ZOOM_USER_ID or an explicit userId is required for server-to-server user/meeting routes.",
        "The live probe verifies meeting access, not merely token issuance."
      ]
    },
    {
      "id": "spotify",
      "provider": "Spotify",
      "priority": 3,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "SPOTIFY_CLIENT_ID",
        "SPOTIFY_CLIENT_SECRET"
      ],
      "targetCapabilities": [
        "library.read",
        "playlists.read",
        "playlists.write"
      ],
      "state": "planned"
    },
    {
      "id": "apple-music",
      "provider": "Apple Music",
      "priority": 3,
      "routes": [
        "musickit",
        "host-local-bridge"
      ],
      "credentialEnv": [
        "APPLE_MUSIC_DEVELOPER_TOKEN"
      ],
      "targetCapabilities": [
        "catalog.search",
        "library.read",
        "playlists.write"
      ],
      "state": "planned"
    },
    {
      "id": "figma",
      "provider": "Figma",
      "priority": 3,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [],
      "targetCapabilities": [
        "files.read",
        "comments.read",
        "comments.write"
      ],
      "state": "planned",
      "credentialAlternatives": [
        [
          "FIGMA_TOKEN"
        ],
        [
          "FIGMA_ACCESS_TOKEN"
        ]
      ],
      "requiredReadScopes": [
        "file_content:read",
        "file_metadata:read"
      ],
      "optionalReadScopes": [
        "file_comments:read"
      ],
      "notes": [
        "Personal access tokens use X-Figma-Token; OAuth access tokens use Bearer authentication."
      ]
    },
    {
      "id": "canva",
      "provider": "Canva",
      "priority": 3,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "CANVA_CLIENT_ID",
        "CANVA_CLIENT_SECRET"
      ],
      "targetCapabilities": [
        "designs.read",
        "designs.write"
      ],
      "state": "planned"
    },
    {
      "id": "adobe",
      "provider": "Adobe",
      "priority": 3,
      "routes": [
        "oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "ADOBE_CLIENT_ID",
        "ADOBE_CLIENT_SECRET"
      ],
      "targetCapabilities": [
        "documents.read",
        "documents.write",
        "creative.read",
        "creative.write"
      ],
      "state": "planned"
    }
  ]
}
