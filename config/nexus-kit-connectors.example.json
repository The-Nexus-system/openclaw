{
  "schemaVersion": 1,
  "policy": {
    "preferIndependentProviderAccess": true,
    "browserAutomationLastResort": true,
    "requirePostconditionVerification": true,
    "storeSecretsInGit": false
  },
  "connectors": [
    {
      "id": "github",
      "provider": "GitHub",
      "priority": 1,
      "routes": [
        "official-api",
        "gh-cli",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "GITHUB_TOKEN"
      ],
      "targetCapabilities": [
        "repos.read",
        "repos.write",
        "issues.read",
        "issues.write",
        "pulls.read",
        "pulls.write"
      ],
      "state": "planned"
    },
    {
      "id": "gmail",
      "provider": "Google",
      "priority": 1,
      "routes": [
        "google-oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REFRESH_TOKEN"
      ],
      "targetCapabilities": [
        "mail.search",
        "mail.read",
        "mail.send",
        "mail.modify"
      ],
      "state": "planned",
      "optionalCredentialEnv": [
        "GOOGLE_REDIRECT_URI",
        "GOOGLE_GRANTED_SCOPES"
      ]
    },
    {
      "id": "google-calendar",
      "provider": "Google",
