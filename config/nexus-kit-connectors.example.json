        "GOOGLE_REFRESH_TOKEN"
      ],
      "targetCapabilities": [
        "calendar.read",
        "calendar.write"
      ],
      "state": "planned",
      "optionalCredentialEnv": [
        "GOOGLE_REDIRECT_URI",
        "GOOGLE_GRANTED_SCOPES"
      ]
    },
    {
      "id": "google-drive",
      "provider": "Google",
      "priority": 1,
      "routes": [
        "google-oauth",
        "official-api",
        "openclaw-plugin"
      ],
      "credentialEnv": [
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REFRESH_TOKEN"
      ],
      "targetCapabilities": [
        "drive.search",
        "drive.read",
        "drive.write"
      ],
