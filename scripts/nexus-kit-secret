#!/usr/bin/env python3
import getpass
import os
import sys

from nexus_kit_secret_store import (
    NAME_RE,
    get,
    load,
    save,
    secret_path,
    set_secret,
    source,
    validate_file,
)


def usage() -> None:
    print("usage: nexus-kit-secret init | set NAME | import-file NAME PATH | list | check NAME", file=sys.stderr)
    raise SystemExit(2)


def main() -> None:
    if len(sys.argv) < 2:
        usage()

    command = sys.argv[1]
    path = secret_path()

    if command == "init":
        if not path.exists():
            save({})
            print(f"Initialized protected connector secret store: {path}")
        else:
            try:
                validate_file(path)
            except RuntimeError as exc:
                raise SystemExit(str(exc)) from exc
            print(f"Connector secret store already exists and passed permission checks: {path}")
        return

    if command == "import-file":
        if len(sys.argv) != 4 or not NAME_RE.fullmatch(sys.argv[2]):
            usage()
        name = sys.argv[2]
        source_path = os.path.abspath(os.path.expanduser(sys.argv[3]))

        try:
            stat_result = os.lstat(source_path)
        except FileNotFoundError as exc:
            raise SystemExit("Source file does not exist.") from exc

        if os.path.islink(source_path):
            raise SystemExit("Refusing to import a secret from a symbolic link.")
        if not os.path.isfile(source_path):
            raise SystemExit("Secret import source must be a regular file.")
        if stat_result.st_size > 1024 * 1024:
            raise SystemExit("Secret import source is larger than 1 MiB; refusing to import.")

        try:
            with open(source_path, "r", encoding="utf-8") as stream:
                value = stream.read()
        except UnicodeDecodeError as exc:
            raise SystemExit("Secret import source must be UTF-8 text.") from exc

        if not value.strip():
            raise SystemExit("Secret import source is empty; nothing was changed.")

        try:
            set_secret(name, value)
        except (RuntimeError, ValueError) as exc:
            raise SystemExit(str(exc)) from exc

        print(f"Imported {name} from a local file into the protected connector secret store.")
        print("The secret value was not displayed.")
        return

    if command == "list":
        try:
            values = load()
        except RuntimeError as exc:
            raise SystemExit(str(exc)) from exc
        if not values:
            print("No connector secrets are stored.")
            return
        for name in sorted(values):
            print(name)
        return

    if command in {"set", "check"}:
        if len(sys.argv) != 3 or not NAME_RE.fullmatch(sys.argv[2]):
            usage()
        name = sys.argv[2]

        if command == "check":
            try:
                found = source(name)
            except RuntimeError as exc:
                raise SystemExit(str(exc)) from exc
            if found:
                print(f"{name}: available from {found}")
                return
            print(f"{name}: not configured")
            raise SystemExit(1)

        value = getpass.getpass(f"Enter {name}: ")
        if not value:
            raise SystemExit("Secret was empty; nothing was changed.")
        verify = getpass.getpass(f"Re-enter {name}: ")
        if value != verify:
            raise SystemExit("Values did not match; nothing was changed.")

        try:
            set_secret(name, value)
        except (RuntimeError, ValueError) as exc:
            raise SystemExit(str(exc)) from exc
        print(f"Stored {name} in the protected connector secret store.")
        return

    usage()


if __name__ == "__main__":
    main()
