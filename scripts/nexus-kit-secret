#!/usr/bin/env python3
import getpass
import json
import os
from pathlib import Path
import re
import stat
import sys
import tempfile

DEFAULT_PATH = Path.home() / ".openclaw" / "kit" / "connector-secrets.json"
NAME_RE = re.compile(r"^[A-Z][A-Z0-9_]{0,127}$")


def secret_path() -> Path:
    raw = os.environ.get("NEXUS_CONNECTOR_SECRETS_FILE", "").strip()
    return Path(raw).expanduser() if raw else DEFAULT_PATH


def validate_file(path: Path) -> None:
    if not path.exists():
        return
    st = path.lstat()
    if stat.S_ISLNK(st.st_mode):
        raise SystemExit("Refusing connector secret store symlink.")
    if not stat.S_ISREG(st.st_mode):
        raise SystemExit("Connector secret store must be a regular file.")
    if os.name != "nt":
        if st.st_uid != os.geteuid():
            raise SystemExit("Connector secret store must be owned by the current user.")
        if stat.S_IMODE(st.st_mode) & 0o077:
            raise SystemExit("Connector secret store must not grant group or world access.")


def load(path: Path) -> dict[str, str]:
    validate_file(path)
    if not path.exists():
        return {}
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise SystemExit("Connector secret store must contain a JSON object.")
    return {str(k): str(v) for k, v in value.items() if isinstance(v, str) and v}


def save(path: Path, values: dict[str, str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if os.name != "nt":
        os.chmod(path.parent, 0o700)

    fd, tmp_name = tempfile.mkstemp(prefix=".connector-secrets-", dir=path.parent)
    tmp = Path(tmp_name)
    try:
        if os.name != "nt":
            os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(values, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, path)
        if os.name != "nt":
            os.chmod(path, 0o600)
        validate_file(path)
    finally:
        if tmp.exists():
            tmp.unlink(missing_ok=True)


def usage() -> None:
    print("usage: nexus-kit-secret init | set NAME | list | check NAME", file=sys.stderr)
    raise SystemExit(2)


def main() -> None:
    if len(sys.argv) < 2:
        usage()

    command = sys.argv[1]
    path = secret_path()

    if command == "init":
        if not path.exists():
            save(path, {})
            print(f"Initialized protected connector secret store: {path}")
        else:
            validate_file(path)
            print(f"Connector secret store already exists and passed permission checks: {path}")
        return

    if command == "list":
        values = load(path)
        if not values:
            print("No connector secrets are stored.")
            return
        for name in sorted(values):
            print(name)
        return

    if command in {"set", "check"}:
        if len(sys.argv) != 3 or not NAME_RE.fullmatch(sys.argv[2]):
            usage()
        name = sys.argv[2]

        if command == "check":
            env_present = bool(os.environ.get(name))
            file_present = name in load(path)
            if env_present:
                print(f"{name}: available from environment")
                return
            if file_present:
                print(f"{name}: available from protected connector store")
                return
            print(f"{name}: not configured")
            raise SystemExit(1)

        value = getpass.getpass(f"Enter {name}: ")
        if not value:
            raise SystemExit("Secret was empty; nothing was changed.")
        verify = getpass.getpass(f"Re-enter {name}: ")
        if value != verify:
            raise SystemExit("Values did not match; nothing was changed.")

        values = load(path)
        values[name] = value
        save(path, values)
        print(f"Stored {name} in the protected connector secret store.")
        return

    usage()


if __name__ == "__main__":
    main()
