#!/usr/bin/env python3
from __future__ import annotations

import os
from pathlib import Path
import shutil

from nexus_kit_secret_store import get

MCP_REMOTE_VERSION = "0.1.38"
METRICOOL_MCP_URL = "https://ai.metricool.com/mcp"


def oauth_cache_exists(state_dir: Path) -> bool:
    if not state_dir.exists():
        return False
    return any(state_dir.rglob("*_tokens.json"))


def main() -> None:
    npx = shutil.which("npx")
    if not npx:
        raise SystemExit("Metricool MCP requires Node.js/npx on the OpenClaw host.")

    state_dir = Path.home() / ".openclaw" / "kit" / "mcp-auth" / "metricool"
    state_dir.mkdir(parents=True, exist_ok=True)
    if os.name != "nt":
        os.chmod(state_dir, 0o700)

    env = os.environ.copy()
    env["MCP_REMOTE_CONFIG_DIR"] = str(state_dir)

    args = [
        npx,
        "-y",
        f"mcp-remote@{MCP_REMOTE_VERSION}",
        METRICOOL_MCP_URL,
        "--transport",
        "http-first",
    ]

    api_key = get("METRICOOL_API_KEY")
    if api_key:
        header_file = state_dir / "headers.txt"
        header_file.write_text(f"X-Mc-Auth: {api_key}\n", encoding="utf-8")
        if os.name != "nt":
            os.chmod(header_file, 0o600)
        args.extend(["--header-file", str(header_file), "--silent"])
    else:
        if not oauth_cache_exists(state_dir):
            raise SystemExit(
                "Metricool OAuth is not authorized on this host. "
                "Run 'nexus-kit-auth metricool' first."
            )
        # Never fall back to an invisible local-browser flow on the headless
        # persistent host. Existing refresh tokens remain non-interactive; if
        # reauthorization becomes necessary, mcp-remote fails through the
        # device-code path and Kit can ask for a foreground auth run.
        args.extend(["--device-code", "--silent"])

    os.execve(npx, args, env)


if __name__ == "__main__":
    main()
