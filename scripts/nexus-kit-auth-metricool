#!/usr/bin/env python3
from __future__ import annotations

import argparse
import getpass
import os
from pathlib import Path
import shutil
import subprocess

from nexus_kit_secret_store import get, set_secret

MCP_REMOTE_VERSION = "0.1.38"
METRICOOL_MCP_URL = "https://ai.metricool.com/mcp"


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Authorize Metricool's official MCP without storing a Metricool password."
    )
    parser.add_argument(
        "--api-key",
        action="store_true",
        help="Use a Metricool API key/header instead of OAuth device authorization.",
    )
    args = parser.parse_args()

    state_dir = Path.home() / ".openclaw" / "kit" / "mcp-auth" / "metricool"
    state_dir.mkdir(parents=True, exist_ok=True)
    if os.name != "nt":
        os.chmod(state_dir, 0o700)

    if args.api_key:
        if get("METRICOOL_API_KEY"):
            print("Metricool API key: already stored.")
            return

        value = getpass.getpass("Metricool API key: ")
        if not value:
            raise SystemExit("Metricool API key was empty; nothing changed.")
        verify = getpass.getpass("Re-enter Metricool API key: ")
        if value != verify:
            raise SystemExit("Metricool API key values did not match; nothing changed.")
        set_secret("METRICOOL_API_KEY", value)
        print("Metricool API key stored in the protected connector vault.")
        return

    npx = shutil.which("npx")
    if not npx:
        raise SystemExit("Metricool OAuth setup requires Node.js/npx on the host.")

    env = os.environ.copy()
    env["MCP_REMOTE_CONFIG_DIR"] = str(state_dir)

    print("Metricool OAuth device authorization")
    print("If Metricool advertises device authorization, a short URL/code will appear below.")
    print("Open it on your phone, approve access, and this command will verify the MCP connection.")
    print()

    completed = subprocess.run(
        [
            npx,
            "-y",
            "-p",
            f"mcp-remote@{MCP_REMOTE_VERSION}",
            "mcp-remote-client",
            METRICOOL_MCP_URL,
            "--device-code",
            "--transport",
            "http-first",
        ],
        env=env,
        check=False,
    )

    if completed.returncode != 0:
        raise SystemExit(
            "Metricool device authorization did not complete. "
            "Do not treat Metricool as verified. If the account exposes an API key, "
            "run nexus-kit-auth metricool --api-key; otherwise we need a different OAuth callback route."
        )

    print()
    print("Metricool MCP authentication completed and the remote server responded.")


if __name__ == "__main__":
    main()
