#!/usr/bin/env python3
from __future__ import annotations

import argparse

from nexus_kit_secret_store import get, import_file, set_secret


def ask_short(name: str, label: str, supplied: str | None) -> str:
    existing = get(name)
    if supplied:
        value = supplied.strip()
        if not value:
            raise SystemExit(f"{label} was empty; nothing changed.")
        set_secret(name, value)
        return value
    if existing:
        print(f"{label}: already stored.")
        return existing

    value = input(f"{label}: ").strip()
    if not value:
        raise SystemExit(f"{label} was empty; nothing changed.")
    set_secret(name, value)
    return value


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Prepare Kit's App Store Connect API credential without pasting the private key."
    )
    parser.add_argument("--issuer-id")
    parser.add_argument("--key-id")
    parser.add_argument("--key-file")
    args = parser.parse_args()

    print("App Store Connect machine authorization")
    print("This stores the short identifiers and imports the private .p8 key locally.")
    print("It does not ask for or store your Apple ID password.")
    print()

    ask_short("APPSTORE_ISSUER_ID", "Issuer ID", args.issuer_id)
    ask_short("APPSTORE_KEY_ID", "Key ID", args.key_id)

    if args.key_file:
        try:
            import_file("APPSTORE_PRIVATE_KEY", args.key_file)
        except (RuntimeError, ValueError) as exc:
            raise SystemExit(str(exc)) from exc
        print("App Store Connect private key imported without displaying it.")
    elif get("APPSTORE_PRIVATE_KEY"):
        print("App Store Connect private key: already stored.")
    else:
        key_file = input("Path to the downloaded App Store Connect .p8 key file: ").strip()
        if not key_file:
            raise SystemExit("No private-key file supplied; nothing else was changed.")
        try:
            import_file("APPSTORE_PRIVATE_KEY", key_file)
        except (RuntimeError, ValueError) as exc:
            raise SystemExit(str(exc)) from exc
        print("App Store Connect private key imported without displaying it.")

    print()
    print("App Store Connect credential setup is ready for a live OpenClaw probe.")
    print("The next verification must successfully list apps through the real App Store Connect API.")


if __name__ == "__main__":
    main()
