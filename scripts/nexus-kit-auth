#!/usr/bin/env python3
from __future__ import annotations

from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent

PROVIDERS: dict[str, tuple[Path, list[str]]] = {
    "microsoft": (ROOT / "nexus-kit-auth-microsoft", []),
    "google": (ROOT / "nexus-kit-auth-google", []),
    "google-workspace": (ROOT / "nexus-kit-auth-google", []),
    "app-store-connect": (ROOT / "nexus-kit-auth-app-store-connect", []),
    "apple": (ROOT / "nexus-kit-auth-app-store-connect", []),
    "google-play": (ROOT / "nexus-kit-auth-google-play", []),
    "dropbox": (ROOT / "nexus-kit-auth-browser", ["dropbox"]),
    "canva": (ROOT / "nexus-kit-auth-browser", ["canva"]),
    "spotify": (ROOT / "nexus-kit-auth-browser", ["spotify"]),
    "zoom": (ROOT / "nexus-kit-auth-browser", ["zoom"]),
    "metricool": (ROOT / "nexus-kit-auth-metricool", []),
}


def usage() -> None:
    print("Nexus Kit accessible authorization")
    print()
    print("usage: nexus-kit-auth PROVIDER [provider options]")
    print()
    print("available providers:")
    for name in sorted(PROVIDERS):
        print(f"  {name}")
    print()
    print("Authorization helpers never ask for ordinary account passwords.")
    raise SystemExit(2)


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] in {"-h", "--help", "help"}:
        usage()

    provider = sys.argv[1].strip().lower()
    entry = PROVIDERS.get(provider)
    if entry is None:
        print(f"Authorization provider is not implemented yet: {provider}", file=sys.stderr)
        usage()

    target, fixed_args = entry
    if not target.exists():
        raise SystemExit(f"Authorization helper is missing: {target}")

    completed = subprocess.run(
        [sys.executable, str(target), *fixed_args, *sys.argv[2:]],
        check=False,
    )
    raise SystemExit(completed.returncode)


if __name__ == "__main__":
    main()
